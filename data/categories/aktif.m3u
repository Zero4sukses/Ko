<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0B0F19">
  <title>Service Premium — Online</title>
  <meta name="description" content="Service Premium is online. Our service is running 24/7.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --ink: #0B0F19;
      --cream: #FBF8F2;
      --gold-light: #F5D78E;
      --gold: #D4A24C;
      --gold-deep: #8F661F;
      --green: #2E9D63;
      --font-display: "Fraunces", Georgia, serif;
      --font-sans: "Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      --font-ar: "Tajawal", "Segoe UI", Tahoma, sans-serif;
      --ease: cubic-bezier(0.22, 1, 0.36, 1);
    }

    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    html, body { margin: 0; padding: 0; }
    html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }

    body {
      min-height: 100vh;
      min-height: 100svh;
      min-height: 100dvh;
      background: var(--ink);
      color: var(--cream);
      font-family: var(--font-sans);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 20px 16px;
      position: relative;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    [dir="rtl"] body { font-family: var(--font-ar); }

    /* Ambient glow */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background: radial-gradient(circle at 50% 50%, rgba(212,162,76,0.18), transparent 55%);
      pointer-events: none;
      z-index: 0;
      animation: glow 8s ease-in-out infinite;
    }
    @keyframes glow {
      0%, 100% { opacity: 0.7; }
      50%      { opacity: 1; }
    }
    /* Dot grid */
    body::after {
      content: "";
      position: fixed;
      inset: 0;
      background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px);
      background-size: 28px 28px;
      pointer-events: none;
      z-index: 0;
    }

    /* ─── Top bar (lang) ─── */
    .top {
      width: 100%;
      display: flex; justify-content: flex-end;
      position: relative; z-index: 2;
      padding: 0 4px;
    }
    .lang-bar {
      display: inline-flex;
      padding: 3px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 999px;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      gap: 1px;
      max-width: 100%;
    }
    .lang-bar button {
      background: transparent; border: 0;
      color: rgba(251,248,242,0.55);
      padding: 6px 10px;
      font-family: inherit;
      font-size: 11px; font-weight: 600;
      letter-spacing: 0.04em;
      border-radius: 999px;
      cursor: pointer;
      transition: color 200ms var(--ease), background 200ms var(--ease);
      flex-shrink: 0;
      min-width: 0;
    }
    .lang-bar button:hover { color: var(--cream); }
    .lang-bar button.active { background: var(--gold); color: var(--ink); }

    /* ─── Center stage ─── */
    .stage {
      position: relative; z-index: 2;
      text-align: center;
      max-width: 640px;
      width: 100%;
      display: flex; flex-direction: column; align-items: center;
      gap: 22px;
      flex: 1;
      justify-content: center;
      padding: 24px 0;
    }

    .mark {
      width: 64px; height: 64px;
      filter: drop-shadow(0 8px 24px rgba(212,162,76,0.3));
    }

    /* Status pill */
    .status {
      display: inline-flex; align-items: center; gap: 9px;
      padding: 7px 14px 7px 12px;
      background: rgba(46, 157, 99, 0.12);
      border: 1px solid rgba(46, 157, 99, 0.4);
      border-radius: 999px;
      font-size: 12px; font-weight: 600;
      letter-spacing: 0.04em;
      color: #6ED49B;
      max-width: 100%;
    }
    [dir="rtl"] .status { letter-spacing: 0; padding: 7px 12px 7px 14px; }
    .pulse {
      width: 9px; height: 9px; border-radius: 50%;
      background: var(--green);
      position: relative; flex-shrink: 0;
    }
    .pulse::after {
      content: "";
      position: absolute; inset: -4px;
      border-radius: 50%;
      background: rgba(46, 157, 99, 0.5);
      animation: pulse 2s ease-out infinite;
    }
    @keyframes pulse {
      0%   { transform: scale(0.6); opacity: 1; }
      100% { transform: scale(2.4); opacity: 0; }
    }

    /* Headline */
    h1 {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: 38px;
      line-height: 1.05;
      letter-spacing: -0.02em;
      margin: 0;
      color: var(--cream);
      max-width: 14ch;
      word-wrap: break-word;
    }
    h1 em {
      font-style: italic;
      font-weight: 400;
      color: var(--gold);
    }
    [dir="rtl"] h1 { font-family: var(--font-ar); letter-spacing: 0; font-weight: 800; }
    [dir="rtl"] h1 em { font-style: normal; font-weight: 800; }

    /* Meta band */
    .meta {
      margin-top: 6px;
      display: flex; align-items: center; justify-content: center;
      gap: 18px;
      padding: 14px 18px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 14px;
      max-width: 100%;
    }
    .meta-item { display: flex; flex-direction: column; gap: 3px; align-items: center; min-width: 0; }
    .meta-num {
      font-family: var(--font-display);
      font-size: 18px; font-weight: 500;
      color: var(--cream);
      letter-spacing: -0.01em;
      line-height: 1;
      white-space: nowrap;
    }
    .meta-num .pct { font-size: 11px; color: rgba(251,248,242,0.5); }
    .meta-lbl {
      font-size: 9.5px;
      color: rgba(251,248,242,0.5);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    [dir="rtl"] .meta-lbl { text-transform: none; letter-spacing: 0; }
    .meta-div { width: 1px; height: 22px; background: rgba(255,255,255,0.1); flex-shrink: 0; }

    /* ─── Bottom (brand) ─── */
    .foot {
      width: 100%;
      display: flex; justify-content: center;
      position: relative; z-index: 2;
      padding: 0 4px;
    }
    .brand-foot {
      display: inline-flex; align-items: center; gap: 8px;
      color: rgba(251,248,242,0.5);
      font-size: 11px; font-weight: 600;
      letter-spacing: 0.06em;
    }
    .brand-foot .fmark {
      width: 22px; height: 22px; border-radius: 6px;
      background: linear-gradient(135deg, var(--gold-light), var(--gold-deep));
      display: inline-flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .brand-foot .fmark svg { width: 12px; height: 12px; }
    .brand-foot-name { color: var(--cream); }
    .brand-foot-sub  { color: var(--gold); margin-left: 4px; letter-spacing: 0.12em; font-size: 9px; }
    [dir="rtl"] .brand-foot-sub { margin-left: 0; margin-right: 4px; }

    /* ─── Larger screens (tablet / desktop) ─── */
    @media (min-width: 540px) {
      body { padding: 24px; }
      .top, .foot { padding: 0; }
      .stage { gap: 28px; padding: 32px 0; }
      .mark { width: 72px; height: 72px; }
      .status { font-size: 13px; padding: 8px 16px 8px 14px; gap: 10px; }
      .pulse { width: 10px; height: 10px; }
      h1 { font-size: clamp(48px, 7vw, 84px); letter-spacing: -0.025em; }
      .meta { gap: 24px; padding: 16px 24px; border-radius: 16px; }
      .meta-num { font-size: 22px; }
      .meta-num .pct { font-size: 13px; }
      .meta-lbl { font-size: 11px; letter-spacing: 0.08em; }
      .meta-div { height: 28px; }
      .lang-bar { padding: 4px; gap: 2px; }
      .lang-bar button { padding: 8px 14px; font-size: 12px; letter-spacing: 0.06em; }
      .brand-foot { font-size: 12px; gap: 10px; }
      .brand-foot .fmark { width: 26px; height: 26px; border-radius: 7px; }
      .brand-foot .fmark svg { width: 14px; height: 14px; }
      .brand-foot-sub { font-size: 10px; }
    }

    /* ─── Very small phones ─── */
    @media (max-width: 360px) {
      h1 { font-size: 32px; }
      .stage { gap: 18px; }
      .meta { gap: 12px; padding: 12px 14px; }
      .meta-num { font-size: 16px; }
      .meta-lbl { font-size: 9px; }
      .lang-bar button { padding: 6px 8px; font-size: 10px; }
    }

    /* ─── Landscape phones (very short height) ─── */
    @media (max-height: 520px) and (orientation: landscape) {
      body { padding: 10px 16px; }
      .stage { gap: 14px; padding: 8px 0; }
      .mark { width: 44px; height: 44px; }
      h1 { font-size: 30px; }
      .meta { padding: 10px 16px; }
    }

    /* Entrance animation */
    .stage > * {
      opacity: 0;
      transform: translateY(10px);
      animation: enter 0.6s var(--ease) forwards;
    }
    .stage > *:nth-child(1) { animation-delay: 0.05s; }
    .stage > *:nth-child(2) { animation-delay: 0.15s; }
    .stage > *:nth-child(3) { animation-delay: 0.25s; }
    .stage > *:nth-child(4) { animation-delay: 0.38s; }
    @keyframes enter {
      to { opacity: 1; transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .stage > *, .pulse::after, body::before { animation: none !important; opacity: 1 !important; transform: none !important; }
    }
  </style>
</head>
<body>

  <!-- Top: language switcher -->
  <div class="top">
    <div class="lang-bar" role="group" aria-label="Language">
      <button data-lang="en" type="button">EN</button>
      <button data-lang="fr" type="button">FR</button>
      <button data-lang="ar" type="button">عربي</button>
      <button data-lang="de" type="button">DE</button>
      <button data-lang="es" type="button">ES</button>
    </div>
  </div>

  <!-- Center stage -->
  <main class="stage">

    <!-- Logo mark -->
    <svg class="mark" viewBox="0 0 64 64" aria-hidden="true">
      <defs>
        <linearGradient id="goldGrad" x1="0" x2="1" y1="0" y2="1">
          <stop offset="0%" stop-color="#F5D78E"/>
          <stop offset="100%" stop-color="#B8862F"/>
        </linearGradient>
      </defs>
      <rect x="2" y="2" width="60" height="60" rx="14" fill="url(#goldGrad)"/>
      <path d="M18 32 L28 42 L46 22" stroke="#0B0F19" stroke-width="4.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

    <!-- Status pill -->
    <div class="status">
      <span class="pulse"></span>
      <span data-i18n="status">All systems operational</span>
    </div>

    <!-- Headline -->
    <h1 data-i18n-html="title">The service is <em>online</em>.</h1>

    <!-- Meta band -->
    <div class="meta">
      <div class="meta-item">
        <div class="meta-num">99.98<span class="pct">%</span></div>
        <div class="meta-lbl" data-i18n="m_uptime">30d uptime</div>
      </div>
      <div class="meta-div"></div>
      <div class="meta-item">
        <div class="meta-num">24/7</div>
        <div class="meta-lbl" data-i18n="m_support">Support</div>
      </div>
      <div class="meta-div"></div>
      <div class="meta-item">
        <div class="meta-num" id="ts">—</div>
        <div class="meta-lbl" data-i18n="m_check">Last check</div>
      </div>
    </div>

  </main>

  <!-- Bottom: brand -->
  <div class="foot">
    <div class="brand-foot">
      <span class="fmark">
        <svg viewBox="0 0 24 24" fill="none" stroke="#0B0F19" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 12 L10 16 L18 8"/>
        </svg>
      </span>
      <span><span class="brand-foot-name">Service</span><span class="brand-foot-sub">PREMIUM</span></span>
    </div>
  </div>

  <script>
    const I18N = {
      en: { status: "All systems operational", title: 'The service is <em>online</em>.', m_uptime: "30d uptime", m_support: "Support", m_check: "Last check", check_now: "just now" },
      fr: { status: "Tous les systèmes opérationnels", title: 'Le service est <em>en ligne</em>.', m_uptime: "Disponibilité 30j", m_support: "Support", m_check: "Dernier contrôle", check_now: "à l'instant" },
      ar: { status: "جميع الخدمات تعمل بشكل طبيعي", title: 'الخدمة <em>متاحة الآن</em>.', m_uptime: "نسبة التوفّر / 30 يوم", m_support: "الدعم", m_check: "آخر فحص", check_now: "الآن" },
      de: { status: "Alle Systeme funktionieren", title: 'Der Dienst ist <em>online</em>.', m_uptime: "30-Tage-Verfügbarkeit", m_support: "Support", m_check: "Letzte Prüfung", check_now: "gerade eben" },
      es: { status: "Todos los sistemas operativos", title: 'El servicio está <em>en línea</em>.', m_uptime: "Disponibilidad 30d", m_support: "Soporte", m_check: "Última comprobación", check_now: "ahora mismo" },
    };

    function setLang(lang) {
      const dict = I18N[lang]; if (!dict) return;
      const html = document.documentElement;
      html.lang = lang;
      html.dir = lang === "ar" ? "rtl" : "ltr";
      document.querySelectorAll("[data-i18n]").forEach((el) => {
        const k = el.getAttribute("data-i18n");
        if (dict[k]) el.textContent = dict[k];
      });
      document.querySelectorAll("[data-i18n-html]").forEach((el) => {
        const k = el.getAttribute("data-i18n-html");
        if (dict[k]) el.innerHTML = dict[k];
      });
      document.querySelectorAll(".lang-bar button").forEach((b) => {
        b.classList.toggle("active", b.dataset.lang === lang);
      });
      document.getElementById("ts").textContent = dict.check_now;
      try { localStorage.setItem("sp_lang", lang); } catch (e) {}
    }

    document.querySelectorAll(".lang-bar button").forEach((b) => {
      b.addEventListener("click", () => setLang(b.dataset.lang));
    });

    let saved = "en";
    try { saved = localStorage.getItem("sp_lang") || saved; } catch (e) {}
    setLang(saved);
  </script>

</body>
</html>

